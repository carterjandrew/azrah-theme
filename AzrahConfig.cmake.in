@PACKAGE_INIT@

set(AZRAH_WITH_KDECORATION @WITH_DECORATIONS@)
if(${AZRAH_WITH_KDECORATION})
    set(AZRAH_KDECORATION_PLUGIN_ID "org.kde.azrah")
else()
    set(AZRAH_KDECORATION_PLUGIN_ID "")
endif()

set(AZRAH_STYLE_NAME "azrah")
set(AZRAH_COLOR_INSTALL_ROOT "@PACKAGE_KDE_INSTALL_FULL_DATADIR@/color-schemes/")
